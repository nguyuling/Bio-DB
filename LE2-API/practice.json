// Get the average price by city

db.listingsAndReview.aggregate([
  {
    $group: {
      _id: "$address.market",
      avg_price: {
        $avg: "$price"
      }
    }
  }
])

// Get the average price by country

db.listingsAndReview.aggregate([
  {
    $group: {
      _id: "$address.country",
      avg_price: {
        $avg: "$price"
      }
    }
  }
])